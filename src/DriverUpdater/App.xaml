<Application x:Class="DriverUpdater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DispatcherUnhandledException="OnUnhandledException">
  <Application.Resources>
    <!-- Palette: near-black blues, neon accents. Contrast of Ink and InkMuted on Panel stays above 4.5:1. -->
    <SolidColorBrush x:Key="Void" Color="#07090F" />
    <SolidColorBrush x:Key="Panel" Color="#0F1420" />
    <SolidColorBrush x:Key="PanelRaised" Color="#121927" />
    <SolidColorBrush x:Key="Edge" Color="#1F2A3F" />
    <SolidColorBrush x:Key="Ink" Color="#E8EEF7" />
    <SolidColorBrush x:Key="InkMuted" Color="#93A1B8" />
    <SolidColorBrush x:Key="NeonCyan" Color="#00E5FF" />
    <SolidColorBrush x:Key="NeonViolet" Color="#B44DFF" />
    <SolidColorBrush x:Key="NeonGreen" Color="#2BFF88" />
    <SolidColorBrush x:Key="NeonAmber" Color="#FFB020" />
    <SolidColorBrush x:Key="NeonPink" Color="#FF2E88" />
    <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#00E5FF" Offset="0" />
      <GradientStop Color="#B44DFF" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Glow" Color="#00E5FF" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />

    <FontFamily x:Key="Display">Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The Fluent theme's accent, repainted neon: buttons, check boxes and progress bars follow it. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#00E5FF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E600E5FF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC00E5FF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#021018" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0F1420" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1F2A3F" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#93A1B8" />

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- The small cyan label above a heading. -->
    <Style x:Key="Kicker" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource NeonCyan}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Side navigation: the tabs become a sidebar with icons. -->
    <Style x:Key="Sidebar" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="24,26,18,22">
                    <TextBlock Text="DRIVER" FontFamily="{StaticResource Display}" FontSize="28" Foreground="{StaticResource NeonGradient}" />
                    <TextBlock Text="UPDATER" FontFamily="{StaticResource Display}" FontSize="28" Foreground="{StaticResource Ink}" Margin="0,-10,0,0" />
                  </StackPanel>
                  <TextBlock DockPanel.Dock="Bottom" Text="{TemplateBinding Tag}" Foreground="{StaticResource InkMuted}"
                             FontSize="11" Margin="24,0,0,16" />
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </DockPanel>
              </Border>
              <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="28,22,28,0" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One sidebar entry: icon (in Tag) and name; the selected one glows. -->
    <Style x:Key="NavItem" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="12,2" Padding="14,10">
              <Grid>
                <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,1,0,1"
                        Background="{StaticResource NeonCyan}" Effect="{StaticResource Glow}" Visibility="Hidden" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="16" Width="18"
                             VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{TemplateBinding Foreground}" />
                  <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                    TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="14" />
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1A00E5FF" />
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{StaticResource NeonCyan}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A group title in the sidebar ("PILOTES"…): a tab that cannot be selected. -->
    <Style x:Key="NavSection" TargetType="TabItem">
      <Setter Property="IsEnabled" Value="False" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <TextBlock Text="{TemplateBinding Header}" FontFamily="{StaticResource Display}" FontSize="11"
                       Foreground="{StaticResource InkMuted}" Opacity="0.75" Margin="28,16,0,4" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dashboard tile: a card that lights up under the mouse and opens its section. -->
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                    CornerRadius="14" Padding="20,18" Margin="0,0,14,14">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NeonCyan}" />
                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Glow}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NeonCyan}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The big round "scan" button of the dashboard. -->
    <Style x:Key="ScanButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="210" Height="210">
              <Ellipse Stroke="{StaticResource NeonGradient}" StrokeThickness="3" Effect="{StaticResource Glow}" />
              <Ellipse x:Name="Face" Margin="14" Fill="{StaticResource Panel}" Stroke="{StaticResource Edge}" StrokeThickness="1" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Fill" Value="#1A00E5FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Fill" Value="#3300E5FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
