<Application x:Class="DriverUpdater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DriverUpdater.UI"
             DispatcherUnhandledException="OnUnhandledException">
  <Application.Resources>
    <!-- Palette: near-black blues, neon accents. Contrast of Ink and InkMuted on Panel stays above 4.5:1. -->
    <SolidColorBrush x:Key="Void" Color="#07090F" />
    <SolidColorBrush x:Key="Panel" Color="#0F1420" />
    <SolidColorBrush x:Key="PanelRaised" Color="#121927" />
    <SolidColorBrush x:Key="Edge" Color="#1F2A3F" />
    <SolidColorBrush x:Key="Ink" Color="#E8EEF7" />
    <SolidColorBrush x:Key="InkMuted" Color="#93A1B8" />
    <SolidColorBrush x:Key="NeonCyan" Color="#00E5FF" />
    <SolidColorBrush x:Key="NeonViolet" Color="#B44DFF" />
    <SolidColorBrush x:Key="NeonGreen" Color="#2BFF88" />
    <SolidColorBrush x:Key="NeonAmber" Color="#FFB020" />
    <SolidColorBrush x:Key="NeonPink" Color="#FF2E88" />
    <!-- Chart bars: the neon cyan, deep enough for marks on the dark surface (checked with the dataviz validator). -->
    <SolidColorBrush x:Key="ChartCyan" Color="#2299C8" />
    <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#00E5FF" Offset="0" />
      <GradientStop Color="#B44DFF" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Glow" Color="#00E5FF" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />

    <FontFamily x:Key="Display">Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The Fluent theme's accent, repainted neon: buttons, check boxes and progress bars follow it. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#00E5FF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E600E5FF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC00E5FF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#021018" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0F1420" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1F2A3F" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#93A1B8" />

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- The small cyan label above a heading. -->
    <Style x:Key="Kicker" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource NeonCyan}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The pages: a TabControl without its strip. The sidebar tree is the only menu (MainWindow.Nav.cs).
         The strip stays Hidden and zero-high, not Collapsed: WPF only creates the pages' containers
         (first page selected, Page style applied) for a panel it measures. -->
    <Style x:Key="Pages" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <StackPanel IsItemsHost="True" Visibility="Hidden" Height="0" />
              <ContentPresenter ContentSource="SelectedContent" Margin="28,22,28,0" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A page inherits its TabItem's Foreground: the text color, not the classic theme's black. -->
    <Style x:Key="Page" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- A group title ("Pilotes"…) between pages: a branch of the menu, never a page. -->
    <Style x:Key="Section" TargetType="TabItem">
      <Setter Property="IsEnabled" Value="False" />
      <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="NavTree" TargetType="TreeView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,0,0,8" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- A branch of the menu: its title opens and closes it (mouse, or arrow keys on the tree). -->
    <Style x:Key="NavGroup" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <ToggleButton x:Name="Toggle" ClickMode="Press" Focusable="False" Cursor="Hand" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Foreground="{StaticResource InkMuted}" BorderBrush="Transparent"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Margin="12,12,12,2" Padding="13,4">
                      <DockPanel>
                        <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource Icons}"
                                   FontSize="10" VerticalAlignment="Center" />
                        <ContentPresenter TextElement.FontFamily="{StaticResource Display}" TextElement.FontSize="11" />
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="False">
                        <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF" />
                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter ContentSource="Header" />
              </ToggleButton>
              <ItemsPresenter x:Name="ItemsHost" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource NeonCyan}" />
                <Setter TargetName="Toggle" Property="Foreground" Value="{StaticResource Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One page of the menu: icon and name; the open one glows. -->
    <Style x:Key="NavPage" TargetType="TreeViewItem">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="8" Margin="12,1" Padding="13,7">
              <Grid>
                <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-13,1,0,1"
                        Background="{StaticResource NeonCyan}" Effect="{StaticResource Glow}" Visibility="Hidden" />
                <ContentPresenter x:Name="Caption" ContentSource="Header"
                                  TextElement.Foreground="{StaticResource InkMuted}" TextElement.FontSize="14" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                <Setter TargetName="Caption" Property="TextElement.Foreground" Value="{StaticResource Ink}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1A00E5FF" />
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                <Setter TargetName="Caption" Property="TextElement.Foreground" Value="{StaticResource NeonCyan}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NeonCyan}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The top of every page (UI/PageHeader.cs). -->
    <Style TargetType="ui:PageHeader">
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <!-- Title and actions on the first line; what the page does, across the whole width, below. -->
          <ControlTemplate TargetType="ui:PageHeader">
            <StackPanel>
              <DockPanel>
                <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Heading}" FontSize="24" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource Muted}" MaxWidth="860" HorizontalAlignment="Left" Margin="0,4,0,0" />
              <TextBlock x:Name="Note" Text="{TemplateBinding Note}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="Note" Value="{x:Null}">
                <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dashboard tile: a card that lights up under the mouse and opens its section. -->
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                    CornerRadius="14" Padding="20,18" Margin="0,0,14,14">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NeonCyan}" />
                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Glow}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NeonCyan}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The big round "scan" button of the dashboard. -->
    <Style x:Key="ScanButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="210" Height="210">
              <Ellipse Stroke="{StaticResource NeonGradient}" StrokeThickness="3" Effect="{StaticResource Glow}" />
              <Ellipse x:Name="Face" Margin="14" Fill="{StaticResource Panel}" Stroke="{StaticResource Edge}" StrokeThickness="1" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Fill" Value="#1A00E5FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Fill" Value="#3300E5FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
