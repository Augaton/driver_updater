<Application x:Class="DriverUpdater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DriverUpdater.UI"
             DispatcherUnhandledException="OnUnhandledException">
  <Application.Resources>
    <!-- Palette: the neutral grays of Windows 11's dark theme, one accent (the one chosen in Windows,
         set by App.ApplyTheme) and Windows' own state colors. Ink and InkMuted stay above 4.5:1 on every
         surface, a chosen table row included. The styles below read it as DynamicResource: with high
         contrast on, App.ApplyTheme swaps it for Windows' own colors after this file is loaded. -->
    <SolidColorBrush x:Key="Void" Color="#202020" />
    <SolidColorBrush x:Key="Chrome" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Panel" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Edge" Color="#383838" />
    <SolidColorBrush x:Key="Ink" Color="#F3F3F3" />
    <SolidColorBrush x:Key="InkMuted" Color="#ADADAD" />
    <!-- Windows' default blue until App.ApplyTheme reads the accent chosen in Windows. -->
    <SolidColorBrush x:Key="Accent" Color="#99EBFF" />
    <!-- Chart bars: the accent one step deeper, calmer over a large area. -->
    <SolidColorBrush x:Key="Chart" Color="#4CC2FF" />
    <!-- States, in the colors Windows 11 gives them on a dark surface. -->
    <SolidColorBrush x:Key="Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="Caution" Color="#FCE100" />
    <SolidColorBrush x:Key="Critical" Color="#FF99A4" />

    <FontFamily x:Key="Display">Segoe UI Variable Display Semibold, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The Fluent theme's surfaces, matched to the palette. Its accent is left alone: buttons, check
         boxes and progress bars take the color chosen in Windows. -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#383838" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#ADADAD" />
    <!-- A chosen row in a table: a neutral gray, not the theme's accent fill with black text, on which
         the states drawn in their own color could not be read. Light enough to see, dark enough for
         every state color and InkMuted to keep 4.5:1. -->
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="#F3F3F3" />

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- One item of a list shown straight on the page (graphics cards, games): a card of its own. -->
    <Style x:Key="ListCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- One item of a list inside a card: a line above it, no card within the card. -->
    <Style x:Key="CardRow" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="0,12" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- The name of a figure (a meter, a dashboard cell), above or below it. -->
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    </Style>

    <!-- Text in a table, centered on the row's height: level with the check box or state beside it, where the
         default style sticks it to the top. MainWindow gives it to every text column without a style of its
         own; the others build on it. -->
    <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The pages: a TabControl without its strip. The sidebar tree is the only menu (MainWindow.Nav.cs).
         The strip stays Hidden and zero-high, not Collapsed: WPF only creates the pages' containers
         (first page selected, Page style applied) for a panel it measures. -->
    <Style x:Key="Pages" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <StackPanel IsItemsHost="True" Visibility="Hidden" Height="0" />
              <ContentPresenter ContentSource="SelectedContent" Margin="28,22,28,0" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A page that scrolls: its scroll bar out at the window's edge, as in Windows' Settings, rather than
         over the cards and buttons along the page's right side. -->
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Margin" Value="0,0,-24,0" />
      <Setter Property="Padding" Value="0,0,24,0" />
    </Style>

    <!-- A page inherits its TabItem's Foreground: the text color, not the classic theme's black. -->
    <Style x:Key="Page" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <!-- A group title ("Pilotes"…) between pages: a branch of the menu, never a page. -->
    <Style x:Key="Section" TargetType="TabItem">
      <Setter Property="IsEnabled" Value="False" />
      <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="NavTree" TargetType="TreeView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,0,0,8" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- A branch of the menu: its title opens and closes it (mouse, or arrow keys on the tree). -->
    <Style x:Key="NavGroup" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <ToggleButton x:Name="Toggle" ClickMode="Press" Focusable="False" Cursor="Hand" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalContentAlignment="Stretch"
                            Foreground="{DynamicResource InkMuted}" BorderBrush="Transparent"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Margin="12,12,12,2" Padding="13,4">
                      <DockPanel>
                        <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource Icons}"
                                   FontSize="10" VerticalAlignment="Center" />
                        <ContentPresenter TextElement.FontSize="11" TextElement.FontWeight="SemiBold" />
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="False">
                        <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF" />
                        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter ContentSource="Header" />
              </ToggleButton>
              <ItemsPresenter x:Name="ItemsHost" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Ink}" />
                <Setter TargetName="Toggle" Property="Foreground" Value="{DynamicResource Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One page of the menu: icon and name; the open one gets a light fill and the accent mark, as
         in Windows' own Settings. -->
    <!-- The label (MainWindow.Nav.cs) is the item's logical child: it takes its color and size from
         the item itself, not from the ContentPresenter that shows it. Set there, they never reached
         it, and the menu was drawn in the default black. -->
    <Style x:Key="NavPage" TargetType="TreeViewItem">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="4" Margin="12,1" Padding="13,7">
              <Grid>
                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="-13,0,0,0" Background="{DynamicResource Accent}" Visibility="Hidden" />
                <ContentPresenter ContentSource="Header" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The top of every page (UI/PageHeader.cs). -->
    <Style TargetType="ui:PageHeader">
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <!-- Title and actions on the first line; what the page does, across the whole width, below. -->
          <ControlTemplate TargetType="ui:PageHeader">
            <StackPanel>
              <DockPanel>
                <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Heading}" FontSize="24" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource Muted}" MaxWidth="860" HorizontalAlignment="Left" Margin="0,4,0,0" />
              <TextBlock x:Name="Note" Text="{TemplateBinding Note}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="Note" Value="{x:Null}">
                <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One cell of the dashboard's status strip: opens its page. A light fill under the mouse,
         a darker one when pressed. -->
    <Style x:Key="StatusCell" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="4" Padding="14,12">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#06FFFFFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
