<Window x:Class="DriverUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver Updater" Width="1080" Height="740" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen" FontSize="13">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleIf" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Margin="12,12,12,0">

      <TabItem Header="Pilotes">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SearchButton" Content="Rechercher" Click="OnSearch" Margin="0,0,8,0" />
              <Button x:Name="HideButton" Content="Masquer la sélection" Click="OnHide" Margin="0,0,8,0" IsEnabled="False" />
              <Button x:Name="InstallButton" Content="Installer la sélection" Style="{DynamicResource AccentButtonStyle}"
                      Click="OnInstall" IsEnabled="False" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Mises à jour de pilotes" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Source : Windows Update, pilotes signés et validés par Microsoft. Les « facultatifs » ne servent qu'à corriger un problème précis : ils sont décochés par défaut." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="DriverGrid" AutomationProperties.Name="Pilotes disponibles"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Title}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Mise à jour proposée" Binding="{Binding Title}" Width="*" />
                  <DataGridTextColumn Header="Daté du" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="85" />
                  <DataGridTextColumn Header="Pilote installé" Binding="{Binding Installed}" Width="190" />
                  <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="95" />
                  <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="70" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="DriverPlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="Lancez une recherche pour voir les pilotes disponibles." />
            </Grid>
          </Border>

          <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <CheckBox x:Name="WeeklyCheckBox" Content="Vérifier chaque semaine et me prévenir"
                      Click="OnWeeklyCheckClick" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="WeeklyCheckNote" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="UnhideButton" Content="Réafficher les pilotes masqués" Click="OnUnhide" />
          </WrapPanel>

          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="12" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <TextBlock Text="Carte graphique" Style="{StaticResource Heading}" FontSize="14" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Windows Update livre les pilotes graphiques avec des mois de retard. Pour les jeux, passez par l'outil du fabricant." />
                <TextBlock x:Name="GpuStatus" Style="{StaticResource Muted}" />
                <ItemsControl x:Name="GpuList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,4">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                Content="{Binding VendorTool}" ContentStringFormat="Ouvrir {0}"
                                Tag="{Binding VendorUrl}" Click="OnOpenVendor"
                                Visibility="{Binding HasVendorTool, Converter={StaticResource VisibleIf}}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Driver}" Style="{StaticResource Muted}" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Gestionnaire de périphériques" Tag="devmgmt.msc"
                          Click="OnOpenSetting" />
                  <TextBlock x:Name="ProblemHeading" Text="Périphériques en erreur" Style="{StaticResource Heading}"
                             FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="ProblemStatus" Style="{StaticResource Muted}" Text="Chargement…" />
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="ProblemList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Margin="0,2" TextWrapping="Wrap">
                          <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                          <Run Text=" — " />
                          <Run Text="{Binding Meaning, Mode=OneWay}" />
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Santé et nettoyage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,0,0">

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Disques" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="État rapporté par Windows. « Avertissement » ou « Défaillant », ou une usure proche de 100 % : sauvegardez vos données sans attendre." />
                <DataGrid x:Name="DiskGrid" Margin="0,8,0,0" AutomationProperties.Name="Disques"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Disque" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                    <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="90" />
                    <DataGridTextColumn Header="État" Binding="{Binding Health}" Width="110" />
                    <DataGridTextColumn Header="Usure" Binding="{Binding Wear}" Width="70" />
                    <DataGridTextColumn Header="Température" Binding="{Binding Temperature}" Width="100" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="DiskStatus" Style="{StaticResource Muted}" />
              </StackPanel>
            </Border>

            <Border x:Name="BatteryCard" Style="{StaticResource Card}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Batterie" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Capacité restante comparée à une batterie neuve. Sous 80 %, l'autonomie baisse nettement ; sous 60 %, pensez à la remplacer." />
                <DataGrid x:Name="BatteryGrid" Margin="0,8,0,0" AutomationProperties.Name="Batteries"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Batterie" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Neuve" Binding="{Binding Designed}" Width="90" />
                    <DataGridTextColumn Header="Aujourd'hui" Binding="{Binding FullCharge}" Width="100" />
                    <DataGridTextColumn Header="Santé" Binding="{Binding Health}" Width="80" />
                    <DataGridTextColumn Header="Cycles" Binding="{Binding Cycles}" Width="70" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Fichiers temporaires" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Fichiers de plus de 2 jours dans votre dossier temporaire et dans C:\Windows\Temp. Les fichiers en cours d'utilisation sont laissés en place." />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="ScanTempButton" Content="Analyser" Click="OnScanTemp" Margin="0,0,8,0" />
                  <Button x:Name="CleanTempButton" Content="Supprimer" Style="{DynamicResource AccentButtonStyle}"
                          Click="OnCleanTemp" IsEnabled="False" />
                  <TextBlock x:Name="TempStatus" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Réglages Windows utiles" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Les outils intégrés font mieux qu'un « booster » : ils montrent l'impact réel de chaque élément." />
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Applications au démarrage" Tag="ms-settings:startupapps" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Assistant de stockage" Tag="ms-settings:storagesense" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Alimentation" Tag="ms-settings:powersleep" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Historique des mises à jour" Tag="ms-settings:windowsupdate-history" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Restaurer le système" Tag="rstrui.exe" Click="OnOpenSetting" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Sauvegarde">
        <StackPanel Margin="0,12,0,0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Sauvegarde des pilotes" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Copie dans un dossier tous les pilotes installés par les fabricants, ceux que Windows ne fournit pas lui-même. Après une réinstallation de Windows, « Restaurer » les remet en une fois." />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BackupButton" Content="Sauvegarder…" Style="{DynamicResource AccentButtonStyle}"
                        Click="OnBackup" Margin="0,0,8,0" />
                <Button x:Name="RestoreBackupButton" Content="Restaurer une sauvegarde…" Click="OnRestoreBackup" />
              </StackPanel>
              <TextBlock x:Name="BackupStatus" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="1" Margin="14,8">
      <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="160" Height="6"
                   IsIndeterminate="True" Visibility="Collapsed" />
      <TextBlock x:Name="StatusText" Text="Prêt." VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
