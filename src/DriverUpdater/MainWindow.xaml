<Window x:Class="DriverUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver Updater" Width="1080" Height="760" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen" FontSize="13">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleIf" />
    <Style x:Key="AdminNote" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="Text" Value="Windows demandera l'autorisation administrateur pour ces actions." />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border x:Name="UpdateBanner" Style="{StaticResource Card}" Margin="12,12,12,0" Padding="12,8" Visibility="Collapsed"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
      <DockPanel>
        <Button x:Name="UpdateBannerButton" DockPanel.Dock="Right" Content="Voir la nouvelle version" Click="OnOpenLink" />
        <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="1" Margin="12,12,12,0" SelectionChanged="OnTabChanged">

      <!-- Drivers -->
      <TabItem Header="Pilotes">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SearchButton" Content="Rechercher" Click="OnSearch" Margin="0,0,8,0" />
              <Button x:Name="HideButton" Content="Masquer la sélection" Click="OnHide" Margin="0,0,8,0" IsEnabled="False" />
              <Button x:Name="InstallButton" Content="Installer la sélection" Style="{DynamicResource AccentButtonStyle}"
                      Click="OnInstall" IsEnabled="False" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Mises à jour de pilotes" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Source : Windows Update, pilotes signés et validés par Microsoft. Les « facultatifs » ne servent qu'à corriger un problème précis : ils sont décochés par défaut." />
              <TextBlock Style="{StaticResource AdminNote}" Text="Installer et masquer demandent l'autorisation administrateur." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="DriverGrid" AutomationProperties.Name="Pilotes disponibles"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Title}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Mise à jour proposée" Binding="{Binding Title}" Width="*" />
                  <DataGridTextColumn Header="Daté du" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="85" />
                  <DataGridTextColumn Header="Pilote installé" Binding="{Binding Installed}" Width="190" />
                  <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="95" />
                  <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="70" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="DriverPlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="Lancez une recherche pour voir les pilotes disponibles." />
            </Grid>
          </Border>

          <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <CheckBox x:Name="WeeklyCheckBox" Content="Vérifier chaque semaine et me prévenir"
                      Click="OnWeeklyCheckClick" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="WeeklyCheckNote" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="UnhideButton" Content="Réafficher les pilotes masqués" Click="OnUnhide" />
          </WrapPanel>

          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="12" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <TextBlock Text="BIOS et carte graphique" Style="{StaticResource Heading}" FontSize="14" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Windows Update les livre avec des mois de retard, ou pas du tout : l'outil du fabricant est la bonne source." />
                <TextBlock x:Name="HardwareStatus" Style="{StaticResource Muted}" />
                <ItemsControl x:Name="HardwareList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,4">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                Content="{Binding Tool}" ContentStringFormat="Ouvrir {0}"
                                Tag="{Binding Url}" Click="OnOpenLink"
                                Visibility="{Binding HasTool, Converter={StaticResource VisibleIf}}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Gestionnaire de périphériques" Tag="devmgmt.msc"
                          Click="OnOpenSetting" />
                  <TextBlock x:Name="ProblemHeading" Text="Périphériques en erreur" Style="{StaticResource Heading}"
                             FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="ProblemStatus" Style="{StaticResource Muted}" Text="Chargement…" />
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="ProblemList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Margin="0,2" TextWrapping="Wrap">
                          <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                          <Run Text=" — " />
                          <Run Text="{Binding Meaning, Mode=OneWay}" />
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Drivers from the Microsoft Update Catalog -->
      <TabItem x:Name="CatalogTab" Header="Pilotes récents">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SearchCatalogButton" Content="Rechercher" Click="OnSearchCatalog" Margin="0,0,8,0" />
              <Button x:Name="InstallCatalogButton" Content="Installer la sélection" Style="{DynamicResource AccentButtonStyle}"
                      Click="OnInstallCatalog" IsEnabled="False" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Pilotes récents des fabricants" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="NVIDIA, AMD, Intel, Realtek… publient leurs pilotes dans le catalogue Microsoft Update, signés par Microsoft, souvent avant que Windows Update ne les propose à votre PC. « Pour votre PC » : fait pour votre modèle exact. « Générique » : fait pour la puce en général ; si votre fabricant a adapté le pilote actuel (portable, audio), Windows le garde. Rien n'est coché d'office." />
              <TextBlock Style="{StaticResource AdminNote}" Text="L'installation demande l'autorisation administrateur et crée d'abord un point de restauration." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="CatalogGrid" AutomationProperties.Name="Pilotes récents"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Device}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Périphérique" Binding="{Binding Device}" Width="*" />
                  <DataGridTextColumn Header="Installé" Binding="{Binding Installed}" Width="190" />
                  <DataGridTextColumn Header="Disponible" Binding="{Binding Available}" Width="110" />
                  <DataGridTextColumn Header="Publié le" Binding="{Binding Entry.Date, StringFormat=dd/MM/yyyy}" Width="85" />
                  <DataGridTextColumn Header="Portée" Binding="{Binding Scope}" Width="105" />
                  <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="70" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="CatalogPlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16"
                         Text="Lancez une recherche : une à deux minutes, le catalogue est interrogé pour chaque périphérique." />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- Software: updates and installed programs -->
      <TabItem x:Name="SoftwareTab" Header="Logiciels">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SearchSoftwareButton" Content="Rechercher" Click="OnSearchSoftware" Margin="0,0,8,0" />
              <Button x:Name="UpgradeSoftwareButton" Content="Mettre à jour la sélection" Style="{DynamicResource AccentButtonStyle}"
                      Click="OnUpgradeSoftware" IsEnabled="False" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Mises à jour de logiciels" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Via winget, le gestionnaire de logiciels intégré à Windows. Un logiciel à jour, c'est des failles de sécurité en moins. Windows peut demander une autorisation pour certains d'entre eux." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="SoftwareGrid" AutomationProperties.Name="Logiciels à mettre à jour"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Name}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Logiciel" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Installé" Binding="{Binding Version}" Width="130" />
                  <DataGridTextColumn Header="Disponible" Binding="{Binding Available}" Width="130" />
                  <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="SoftwarePlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="Lancez une recherche pour voir les logiciels à mettre à jour." />
            </Grid>
          </Border>

          <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
              <TextBox x:Name="ProgramFilter" Width="200" Margin="0,0,8,0" VerticalContentAlignment="Center"
                       TextChanged="OnProgramFilterChanged" AutomationProperties.Name="Filtrer les programmes" />
              <Button x:Name="UninstallButton" Content="Désinstaller…" Click="OnUninstall" Margin="0,0,8,0" />
              <Button x:Name="FindLeftoversButton" Content="Chercher les restes" Click="OnFindLeftovers" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Programmes installés" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Désinstaller lance le désinstalleur du programme. Ensuite, « Chercher les restes » propose les dossiers qu'il a laissés ; ils partent à la corbeille, donc rien n'est perdu. Le registre n'est pas « nettoyé » : ça ne fait rien gagner et c'est la cause de casse n° 1." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="ProgramGrid" AutomationProperties.Name="Programmes installés" SelectionMode="Single"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Programme" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="180" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
                <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" SortMemberPath="Size" Width="80" />
                <DataGridTextColumn Header="Installé le" Binding="{Binding InstalledOn, StringFormat=dd/MM/yyyy}" Width="90" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <Border x:Name="LeftoverCard" Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
              <DockPanel>
                <Button x:Name="RecycleButton" DockPanel.Dock="Right" Content="Mettre à la corbeille" Style="{DynamicResource AccentButtonStyle}"
                        Click="OnRecycleLeftovers" VerticalAlignment="Top" />
                <TextBlock x:Name="LeftoverHeading" Style="{StaticResource Heading}" FontSize="14" TextWrapping="Wrap" />
              </DockPanel>
              <TextBlock Style="{StaticResource Muted}"
                         Text="Cochés d'office : le dossier d'installation déclaré. Les autres portent seulement le même nom : vérifiez avant de cocher. Dossiers de Program Files et ProgramData : autorisation administrateur." />
              <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl x:Name="LeftoverList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Margin="0,2">
                        <TextBlock TextWrapping="Wrap">
                          <Run Text="{Binding Path, Mode=OneWay}" />
                          <Run Text=" — " />
                          <Run Text="{Binding Reason, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Startup programs and boot measurements -->
      <TabItem x:Name="StartupTab" Header="Démarrage">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="RefreshStartupButton" Content="Actualiser" Click="OnRefreshStartup" Margin="0,0,8,0" />
              <Button x:Name="BootReportButton" Content="Mesurer leur impact" Style="{DynamicResource AccentButtonStyle}" Click="OnBootReport" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Programmes au démarrage" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Décochez ce qui n'a pas besoin de démarrer avec Windows : c'est réversible, et le Gestionnaire des tâches voit le même réglage. « Mesurer leur impact » lit les temps que Windows a lui-même mesurés lors des derniers démarrages." />
              <TextBlock Style="{StaticResource AdminNote}" Text="Les entrées « Tous les utilisateurs », et parfois la mesure, demandent l'autorisation administrateur." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="StartupGrid" AutomationProperties.Name="Programmes au démarrage"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Actif" Width="56">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnStartupToggle"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Programme" Binding="{Binding Title}" Width="200" />
                <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="170" />
                <DataGridTextColumn Header="Ralentit le démarrage" Binding="{Binding Impact}" Width="150" />
                <DataGridTextColumn Header="Pour" Binding="{Binding Scope}" Width="140" />
                <DataGridTextColumn Header="Commande" Binding="{Binding Command}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" x:Name="BootCard" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Démarrages de Windows (30 derniers jours)" Style="{StaticResource Heading}" FontSize="14" />
              <TextBlock x:Name="BootSummary" TextWrapping="Wrap" />
              <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <ItemsControl x:Name="SlowdownList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,2" TextWrapping="Wrap">
                        <Run Text="{Binding FriendlyName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" — " />
                        <Run Text="{Binding Kind, Mode=OneWay}" />
                        <Run Text=" — " />
                        <Run Text="{Binding AverageText, Mode=OneWay}" />
                        <Run Text="en moyenne," Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding Times, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="fois" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Performance -->
      <TabItem x:Name="PerformanceTab" Header="Performances">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Gestionnaire des tâches" Tag="taskmgr.exe" Click="OnOpenSetting" Margin="0,0,8,0" />
              <Button x:Name="MeasureButton" Content="Analyser (10 s)" Style="{DynamicResource AccentButtonStyle}" Click="OnMeasure" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Ce qui ralentit le PC" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Observe le PC pendant 10 secondes et classe les applications par ce qu'elles consomment. Lancez-la quand le PC rame. Pour agir : onglet Démarrage (ce qui se lance tout seul) ou Logiciels (désinstaller)." />
            </StackPanel>
          </DockPanel>

          <WrapPanel Grid.Row="1" x:Name="UsagePanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150">
              <StackPanel><TextBlock Text="Processeur" Style="{StaticResource Muted}" /><TextBlock x:Name="CpuValue" Style="{StaticResource Heading}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150">
              <StackPanel><TextBlock Text="Mémoire" Style="{StaticResource Muted}" /><TextBlock x:Name="MemoryValue" Style="{StaticResource Heading}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150">
              <StackPanel><TextBlock Text="Disque" Style="{StaticResource Muted}" /><TextBlock x:Name="DiskValue" Style="{StaticResource Heading}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150">
              <StackPanel><TextBlock Text="Carte graphique" Style="{StaticResource Muted}" /><TextBlock x:Name="GpuValue" Style="{StaticResource Heading}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150">
              <StackPanel><TextBlock Text="Alimentation" Style="{StaticResource Muted}" /><TextBlock x:Name="PowerValue" Style="{StaticResource Heading}" /></StackPanel>
            </Border>
          </WrapPanel>

          <ItemsControl Grid.Row="2" x:Name="FindingList" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="UsageGrid" AutomationProperties.Name="Consommation par application"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Processeur" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="100" />
                  <DataGridTextColumn Header="Mémoire" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="100" />
                  <DataGridTextColumn Header="Disque" Binding="{Binding DiskText}" SortMemberPath="DiskBytesPerSecond" Width="100" />
                  <DataGridTextColumn Header="Carte graphique" Binding="{Binding GpuText}" SortMemberPath="Gpu" Width="120" />
                  <DataGridTextColumn Header="Processus" Binding="{Binding Processes}" Width="80" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="UsagePlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="Lancez une analyse pour voir ce qui consomme." />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- Health -->
      <TabItem x:Name="HealthTab" Header="Santé et nettoyage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,0,0">

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="HealthDetailsButton" DockPanel.Dock="Right" Content="Usure et température…"
                          Click="OnHealthDetails" VerticalAlignment="Top" />
                  <TextBlock Text="Disques" Style="{StaticResource Heading}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}"
                           Text="État rapporté par Windows. « Avertissement » ou « Défaillant », ou une usure proche de 100 % : sauvegardez vos données sans attendre. L'usure, la température et la batterie demandent l'autorisation administrateur." />
                <DataGrid x:Name="DiskGrid" Margin="0,8,0,0" AutomationProperties.Name="Disques"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Disque" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                    <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="90" />
                    <DataGridTextColumn Header="État" Binding="{Binding Health}" Width="110" />
                    <DataGridTextColumn Header="Usure" Binding="{Binding Wear}" Width="70" />
                    <DataGridTextColumn Header="Température" Binding="{Binding Temperature}" Width="100" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="DiskStatus" Style="{StaticResource Muted}" />
              </StackPanel>
            </Border>

            <Border x:Name="BatteryCard" Style="{StaticResource Card}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Batterie" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Capacité restante comparée à une batterie neuve. Sous 80 %, l'autonomie baisse nettement ; sous 60 %, pensez à la remplacer." />
                <DataGrid x:Name="BatteryGrid" Margin="0,8,0,0" AutomationProperties.Name="Batteries"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Batterie" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Neuve" Binding="{Binding Designed}" Width="90" />
                    <DataGridTextColumn Header="Aujourd'hui" Binding="{Binding FullCharge}" Width="100" />
                    <DataGridTextColumn Header="Santé" Binding="{Binding Health}" Width="80" />
                    <DataGridTextColumn Header="Cycles" Binding="{Binding Cycles}" Width="70" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Fichiers temporaires" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Fichiers de plus de 2 jours dans votre dossier temporaire. Les fichiers en cours d'utilisation sont laissés en place. Le dossier temporaire de Windows (C:\Windows\Temp) demande l'autorisation administrateur." />
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="ScanTempButton" Content="Analyser" Click="OnScanTemp" Margin="0,0,8,8" />
                  <Button x:Name="CleanTempButton" Content="Supprimer" Style="{DynamicResource AccentButtonStyle}"
                          Click="OnCleanTemp" IsEnabled="False" Margin="0,0,8,8" />
                  <Button x:Name="CleanWindowsTempButton" Content="Nettoyer aussi C:\Windows\Temp…"
                          Click="OnCleanWindowsTemp" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock x:Name="TempStatus" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Réparer Windows" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Les outils de Microsoft. SFC vérifie et répare les fichiers système ; DISM répare l'image de Windows dont SFC se sert (à lancer d'abord si SFC n'y arrive pas) ; le nettoyage des composants supprime les anciennes versions gardées après les mises à jour et libère souvent plusieurs Go. Comptez 10 à 30 minutes." />
                <TextBlock Style="{StaticResource AdminNote}" />
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="SfcButton" Content="Vérifier les fichiers système (SFC)" Tag="sfc" Click="OnRepair" Margin="0,0,8,8" />
                  <Button x:Name="DismRestoreButton" Content="Réparer l'image Windows (DISM)" Tag="dism-restore" Click="OnRepair" Margin="0,0,8,8" />
                  <Button x:Name="DismCleanupButton" Content="Nettoyer les composants Windows" Tag="dism-cleanup" Click="OnRepair" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock x:Name="RepairStatus" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Réglages Windows utiles" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Les outils intégrés font mieux qu'un « booster » : ils montrent l'impact réel de chaque élément." />
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Applications au démarrage" Tag="ms-settings:startupapps" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Assistant de stockage" Tag="ms-settings:storagesense" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Alimentation" Tag="ms-settings:powersleep" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Historique des mises à jour" Tag="ms-settings:windowsupdate-history" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Restaurer le système" Tag="rstrui.exe" Click="OnOpenSetting" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Backup -->
      <TabItem Header="Sauvegarde">
        <StackPanel Margin="0,12,0,0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Sauvegarde des pilotes" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Copie dans un dossier tous les pilotes installés par les fabricants, ceux que Windows ne fournit pas lui-même. Après une réinstallation de Windows, « Restaurer » les remet en une fois." />
              <TextBlock Style="{StaticResource AdminNote}" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BackupButton" Content="Sauvegarder…" Style="{DynamicResource AccentButtonStyle}"
                        Click="OnBackup" Margin="0,0,8,0" />
                <Button x:Name="RestoreBackupButton" Content="Restaurer une sauvegarde…" Click="OnRestoreBackup" />
              </StackPanel>
              <TextBlock x:Name="BackupStatus" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- History -->
      <TabItem x:Name="HistoryTab" Header="Historique">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Actualiser" Click="OnRefreshHistory" VerticalAlignment="Center" />
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Pilotes installés" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Ce que Windows Update a installé, par cette application ou par lui-même. Un problème apparu après une date ? Le pilote installé ce jour-là est un bon suspect : « Restaurer le système » ou le Gestionnaire de périphériques permettent de revenir en arrière." />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="HistoryGrid" AutomationProperties.Name="Historique des pilotes"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
                  <DataGridTextColumn Header="Pilote" Binding="{Binding Title}" Width="*" />
                  <DataGridTextColumn Header="Résultat" Binding="{Binding Result}" Width="160" />
                  <DataGridTextColumn Header="Par" Binding="{Binding Via}" Width="120" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="HistoryPlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Text="Chargement…" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="2" Margin="14,8">
      <Button DockPanel.Dock="Right" Content="Copier le diagnostic" Click="OnCopyDiagnostics" Margin="12,0,0,0" />
      <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="160" Height="6" VerticalAlignment="Center"
                   IsIndeterminate="True" Visibility="Collapsed" />
      <TextBlock x:Name="StatusText" Text="Prêt." VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
