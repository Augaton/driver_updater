<Project>
  <!-- dotnet publish src/DriverUpdater -c Release -p:PublishProfile=win-x64 -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Runs on a PC without .NET installed. Rebuild after each .NET patch release:
         the runtime inside the exe does not update itself. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Not IncludeNativeLibrariesForSelfExtract: it unpacks DLLs into %TEMP%, where any
         program could swap them before this administrator app loads them. The few native
         WPF DLLs ship next to the exe instead. -->
    <!-- Precompiled code: faster start-up. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
