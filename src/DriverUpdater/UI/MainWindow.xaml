<Window x:Class="DriverUpdater.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DriverUpdater.UI"
        Title="Driver Updater" Width="1240" Height="800" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource Void}" Foreground="{StaticResource Ink}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleIf" />
    <DataTemplate x:Key="TweakRowTemplate">
      <Border Background="{StaticResource PanelRaised}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Tag="{Binding}" Click="OnTweakAction" IsEnabled="{Binding CanAct}"
                  VerticalAlignment="Center" MinWidth="120" Margin="12,0,0,0" />
          <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="18"
                     Foreground="{Binding Color}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <StackPanel>
            <TextBlock TextWrapping="Wrap">
              <Run Text="{Binding Tweak.Title, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="{Binding Badges, Mode=OneWay}" Foreground="{StaticResource InkMuted}" FontSize="11" />
            </TextBlock>
            <TextBlock Text="{Binding Tweak.Why}" Style="{StaticResource Muted}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
    <Style x:Key="AdminNote" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="Text" Value="Windows demandera l'autorisation administrateur pour ces actions." />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl x:Name="Tabs" Style="{StaticResource Sidebar}" ItemContainerStyle="{StaticResource NavItem}"
                SelectionChanged="OnTabChanged">
      <!-- Home: the big button scans every driver, the report says what to do -->
      <TabItem x:Name="HomeTab" Header="Accueil" Tag="&#xE80F;">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- PC on the left, the big button in the middle, the verdict on the right. -->
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="TABLEAU DE BORD" Style="{StaticResource Kicker}" />
              <TextBlock x:Name="PcTitle" Text="Votre PC" Style="{StaticResource Heading}" FontSize="26" TextWrapping="Wrap" />
              <TextBlock x:Name="PcSummary" Style="{StaticResource Muted}" />
            </StackPanel>

            <Grid Grid.Column="1" Width="250" Height="250">
              <Ellipse x:Name="ScanRing" Width="238" Height="238" Stroke="{StaticResource NeonCyan}" StrokeThickness="2"
                       StrokeDashArray="2 6" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Ellipse.RenderTransform>
                  <RotateTransform x:Name="ScanRotation" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <Button x:Name="ScanButton" Style="{StaticResource ScanButton}" Click="OnScanAll"
                      AutomationProperties.Name="Analyser tous les pilotes" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="30" HorizontalAlignment="Center"
                             Foreground="{StaticResource NeonCyan}" />
                  <TextBlock Text="ANALYSER" FontFamily="{StaticResource Display}" FontSize="28" HorizontalAlignment="Center" Margin="0,8,0,0" />
                  <TextBlock Text="tous les pilotes" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0">
              <TextBlock Text="RAPPORT DES PILOTES" Style="{StaticResource Kicker}" />
              <UniformGrid Columns="2" Margin="0,6,0,0">
                <StackPanel Margin="0,0,0,10">
                  <TextBlock x:Name="ReportTotal" Text="—" FontFamily="{StaticResource Display}" FontSize="32" />
                  <TextBlock Text="analysés" Style="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                  <TextBlock x:Name="ReportOk" Text="—" FontFamily="{StaticResource Display}" FontSize="32" Foreground="{StaticResource NeonGreen}" />
                  <TextBlock Text="à jour" Style="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="ReportUpdates" Text="—" FontFamily="{StaticResource Display}" FontSize="32" Foreground="{StaticResource NeonCyan}" />
                  <TextBlock Text="à mettre à jour" Style="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="ReportIssues" Text="—" FontFamily="{StaticResource Display}" FontSize="32" Foreground="{StaticResource NeonAmber}" />
                  <TextBlock Text="sans pilote ou en erreur" Style="{StaticResource Muted}" />
                </StackPanel>
              </UniformGrid>
            </StackPanel>
          </Grid>

          <!-- The report itself: one line per device, updates first and ticked. -->
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
                <DockPanel>
                  <Button x:Name="UpdateAllButton" DockPanel.Dock="Right" Content="Mettre à jour la sélection"
                          Style="{DynamicResource AccentButtonStyle}" Click="OnUpdateAll" IsEnabled="False" />
                  <CheckBox x:Name="ShowUpToDate" DockPanel.Dock="Right" Content="Afficher aussi les pilotes à jour"
                            Click="OnShowUpToDate" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <TextBlock x:Name="ScanStatus" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource InkMuted}"
                             Text="Appuyez sur ANALYSER : chaque pilote est comparé aux dernières versions de Windows Update et des fabricants." />
                </DockPanel>
              </Border>
              <Grid>
                <DataGrid x:Name="ReportGrid" AutomationProperties.Name="Rapport des pilotes"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInstall}"
                                    Click="OnReportChoiceChanged" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Device.Name}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="État" Width="170" SortMemberPath="Verdict">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock x:Name="State" Text="{Binding VerdictText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                     Foreground="{StaticResource NeonGreen}" />
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Verdict}" Value="Update">
                              <Setter TargetName="State" Property="Foreground" Value="{StaticResource NeonCyan}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Verdict}" Value="NoDriver">
                              <Setter TargetName="State" Property="Foreground" Value="{StaticResource NeonAmber}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Verdict}" Value="Problem">
                              <Setter TargetName="State" Property="Foreground" Value="{StaticResource NeonPink}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Verdict}" Value="Disabled">
                              <Setter TargetName="State" Property="Foreground" Value="{StaticResource InkMuted}" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Périphérique" Binding="{Binding Device.Name}" Width="*" />
                    <DataGridTextColumn Header="Classe" Binding="{Binding Device.Class}" Width="100" />
                    <DataGridTextColumn Header="Installé" Binding="{Binding Installed}" Width="190" />
                    <DataGridTextColumn Header="Disponible" Binding="{Binding Available}" Width="190" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="ReportPlaceholder" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Margin="24" Text="Le rapport apparaîtra ici." />
              </Grid>
            </DockPanel>
          </Border>

          <!-- The rest of the PC, checked by the same scan. -->
          <UniformGrid Grid.Row="2" Columns="4">
            <Button Style="{StaticResource Tile}" Tag="SoftwareTab" Click="OnTile">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE71D;" FontFamily="{StaticResource Icons}" FontSize="24"
                           Foreground="{StaticResource NeonGreen}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock DockPanel.Dock="Right" x:Name="TileSoftwareValue" Text="—" FontFamily="{StaticResource Display}" FontSize="28" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="LOGICIELS" Style="{StaticResource Kicker}" />
                  <TextBlock x:Name="TileSoftwareText" Text="à mettre à jour" Style="{StaticResource Muted}" />
                </StackPanel>
              </DockPanel>
            </Button>
            <Button Style="{StaticResource Tile}" Tag="StartupTab" Click="OnTile">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="24"
                           Foreground="{StaticResource NeonPink}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock DockPanel.Dock="Right" x:Name="TileStartupValue" Text="—" FontFamily="{StaticResource Display}" FontSize="28" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="DÉMARRAGE" Style="{StaticResource Kicker}" />
                  <TextBlock x:Name="TileStartupText" Text="programmes lancés avec Windows" Style="{StaticResource Muted}" />
                </StackPanel>
              </DockPanel>
            </Button>
            <Button Style="{StaticResource Tile}" Tag="HealthTab" Click="OnTile">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="24"
                           Foreground="{StaticResource NeonViolet}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock DockPanel.Dock="Right" x:Name="TileSecurityValue" Text="—" FontFamily="{StaticResource Display}" FontSize="28" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="SÉCURITÉ" Style="{StaticResource Kicker}" />
                  <TextBlock x:Name="TileSecurityText" Text="antivirus, pare-feu, Windows" Style="{StaticResource Muted}" />
                </StackPanel>
              </DockPanel>
            </Button>
            <Button Style="{StaticResource Tile}" Tag="HealthTab" Click="OnTile">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE95E;" FontFamily="{StaticResource Icons}" FontSize="24"
                           Foreground="{StaticResource NeonCyan}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock DockPanel.Dock="Right" x:Name="TileDisksValue" Text="—" FontFamily="{StaticResource Display}" FontSize="28" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="DISQUES" Style="{StaticResource Kicker}" />
                  <TextBlock x:Name="TileDisksText" Text="état de santé" Style="{StaticResource Muted}" />
                </StackPanel>
              </DockPanel>
            </Button>
          </UniformGrid>
        </Grid>
      </TabItem>

      <TabItem Header="PILOTES" Style="{StaticResource NavSection}" />

      <!-- Drivers -->
      <TabItem x:Name="DriversTab" Header="Windows Update" Tag="&#xE895;">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SearchButton" Content="Rechercher" Click="OnSearch" Margin="0,0,8,0" />
              <Button x:Name="HideButton" Content="Masquer la sélection" Click="OnHide" Margin="0,0,8,0" IsEnabled="False" />
              <Button x:Name="InstallButton" Content="Installer la sélection" Style="{DynamicResource AccentButtonStyle}"
                      Click="OnInstall" IsEnabled="False" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Mises à jour de pilotes" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Source : Windows Update, pilotes signés et validés par Microsoft. Les « facultatifs » ne servent qu'à corriger un problème précis : ils sont décochés par défaut." />
              <TextBlock Style="{StaticResource AdminNote}" Text="Installer et masquer demandent l'autorisation administrateur." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="DriverGrid" AutomationProperties.Name="Pilotes disponibles"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Title}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Mise à jour proposée" Binding="{Binding Title}" Width="*" />
                  <DataGridTextColumn Header="Daté du" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="85" />
                  <DataGridTextColumn Header="Pilote installé" Binding="{Binding Installed}" Width="190" />
                  <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="95" />
                  <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="70" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="DriverPlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="Lancez une recherche pour voir les pilotes disponibles." />
            </Grid>
          </Border>

          <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <CheckBox x:Name="WeeklyCheckBox" Content="Vérifier chaque semaine et me prévenir"
                      Click="OnWeeklyCheckClick" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="WeeklyCheckNote" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="UnhideButton" Content="Réafficher les pilotes masqués" Click="OnUnhide" />
          </WrapPanel>

          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="12" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <TextBlock Text="BIOS et carte graphique" Style="{StaticResource Heading}" FontSize="14" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Windows Update les livre avec des mois de retard, ou pas du tout : l'outil du fabricant est la bonne source." />
                <TextBlock x:Name="HardwareStatus" Style="{StaticResource Muted}" />
                <ItemsControl x:Name="HardwareList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,4">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                Content="{Binding Tool}" ContentStringFormat="Ouvrir {0}"
                                Tag="{Binding Url}" Click="OnOpenLink"
                                Visibility="{Binding HasTool, Converter={StaticResource VisibleIf}}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Gestionnaire de périphériques" Tag="devmgmt.msc"
                          Click="OnOpenSetting" />
                  <TextBlock x:Name="ProblemHeading" Text="Périphériques en erreur" Style="{StaticResource Heading}"
                             FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="ProblemStatus" Style="{StaticResource Muted}" Text="Chargement…" />
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="ProblemList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Margin="0,2" TextWrapping="Wrap">
                          <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                          <Run Text=" — " />
                          <Run Text="{Binding Meaning, Mode=OneWay}" />
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Drivers from the Microsoft Update Catalog -->
      <TabItem x:Name="CatalogTab" Header="Fabricants" Tag="&#xE896;">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SearchCatalogButton" Content="Rechercher" Click="OnSearchCatalog" Margin="0,0,8,0" />
              <Button x:Name="InstallCatalogButton" Content="Installer la sélection" Style="{DynamicResource AccentButtonStyle}"
                      Click="OnInstallCatalog" IsEnabled="False" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Pilotes récents des fabricants" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="NVIDIA, AMD, Intel, Realtek… publient leurs pilotes dans le catalogue Microsoft Update, signés par Microsoft, souvent avant que Windows Update ne les propose à votre PC. « Pour votre PC » : fait pour votre modèle exact. « Générique » : fait pour la puce en général ; si votre fabricant a adapté le pilote actuel (portable, audio), Windows le garde. Rien n'est coché d'office." />
              <TextBlock Style="{StaticResource AdminNote}" Text="L'installation demande l'autorisation administrateur et crée d'abord un point de restauration." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="CatalogGrid" AutomationProperties.Name="Pilotes récents"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Device}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Périphérique" Binding="{Binding Device}" Width="*" />
                  <DataGridTextColumn Header="Installé" Binding="{Binding Installed}" Width="190" />
                  <DataGridTemplateColumn Header="Version à installer" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding Versions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding Entry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="Version à installer" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Portée" Binding="{Binding Scope}" Width="105" />
                  <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="70" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="CatalogPlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16"
                         Text="Lancez une recherche : une à deux minutes, le catalogue est interrogé pour chaque périphérique." />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- Inventory: every device and its driver, and old driver versions kept by Windows -->
      <TabItem x:Name="InventoryTab" Header="Inventaire" Tag="&#xE772;">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <ComboBox x:Name="InventoryFilter" Width="230" Margin="0,0,8,0" SelectedIndex="0"
                        SelectionChanged="OnInventoryFilterChanged" AutomationProperties.Name="Filtrer les périphériques">
                <ComboBoxItem Content="Tous les périphériques" />
                <ComboBoxItem Content="À problème" />
                <ComboBoxItem Content="Sans pilote" />
                <ComboBoxItem Content="Pilotes de plus de 3 ans" />
                <ComboBoxItem Content="Pilotes non signés" />
                <ComboBoxItem Content="Pilotes de fabricants" />
              </ComboBox>
              <Button x:Name="RollbackButton" Content="Revenir au pilote précédent" Click="OnRollback" Margin="0,0,8,0"
                      ToolTip="Le périphérique sélectionné reprend le pilote qu'il avait avant sa dernière mise à jour." />
              <Button x:Name="RefreshInventoryButton" Content="Actualiser" Click="OnRefreshInventory" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="INVENTAIRE" Style="{StaticResource Kicker}" />
              <TextBlock Text="Tous vos pilotes" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Chaque périphérique du PC, son pilote et son état. La liste se met à jour toute seule quand vous branchez ou débranchez quelque chose." />
            </StackPanel>
          </DockPanel>

          <TextBlock Grid.Row="1" x:Name="InventorySummary" Foreground="{StaticResource InkMuted}" Margin="0,0,0,10" />

          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="InventoryGrid" AutomationProperties.Name="Inventaire des pilotes"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource NeonAmber}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Périphérique" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Classe" Binding="{Binding Class}" Width="110" />
                <DataGridTextColumn Header="Fournisseur" Binding="{Binding Provider}" Width="170" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="140" />
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" SortMemberPath="Date" Width="90" />
                <DataGridTextColumn Header="Signé" Binding="{Binding SignedText}" Width="60" />
                <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="110" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                  <Button x:Name="StoreScanButton" Content="Chercher les anciennes versions…" Click="OnStoreScan" Margin="0,0,8,0" />
                  <Button x:Name="StoreDeleteButton" Content="Supprimer la sélection" Style="{DynamicResource AccentButtonStyle}"
                          Click="OnStoreDelete" IsEnabled="False" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="Anciennes versions de pilotes" Style="{StaticResource Heading}" FontSize="16" />
                  <TextBlock Style="{StaticResource Muted}"
                             Text="Windows garde chaque version de pilote qu'il a installée : près de 1 Go par mise à jour de pilote graphique. Celles qu'aucun périphérique n'utilise et qu'une version plus récente remplace peuvent partir ; Windows refuse de toute façon de supprimer un pilote utilisé." />
                  <TextBlock Style="{StaticResource AdminNote}" />
                </StackPanel>
              </DockPanel>
              <TextBlock x:Name="StoreSummary" Margin="0,8,0,0" TextWrapping="Wrap" />
              <DataGrid x:Name="StoreGrid" AutomationProperties.Name="Anciennes versions de pilotes" MaxHeight="190" Margin="0,8,0,0"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Visibility="Collapsed"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Click="OnStoreChoiceChanged"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Package.OriginalName}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Pilote" Binding="{Binding Package.OriginalName}" Width="*" />
                  <DataGridTextColumn Header="Fournisseur" Binding="{Binding Package.Provider}" Width="160" />
                  <DataGridTextColumn Header="Classe" Binding="{Binding Package.Class}" Width="100" />
                  <DataGridTextColumn Header="Version" Binding="{Binding Package.VersionText}" Width="130" />
                  <DataGridTextColumn Header="Date" Binding="{Binding Package.DateText}" Width="90" />
                  <DataGridTextColumn Header="Taille" Binding="{Binding Package.SizeText}" SortMemberPath="Package.Size" Width="80" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Backup -->
      <TabItem x:Name="BackupTab" Header="Sauvegarde" Tag="&#xE74E;">
        <StackPanel Margin="0,12,0,0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Sauvegarde des pilotes" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Copie dans un dossier tous les pilotes installés par les fabricants, ceux que Windows ne fournit pas lui-même. Après une réinstallation de Windows, « Restaurer » les remet en une fois." />
              <TextBlock Style="{StaticResource AdminNote}" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BackupButton" Content="Sauvegarder…" Style="{DynamicResource AccentButtonStyle}"
                        Click="OnBackup" Margin="0,0,8,0" />
                <Button x:Name="RestoreBackupButton" Content="Restaurer une sauvegarde…" Click="OnRestoreBackup" />
              </StackPanel>
              <TextBlock x:Name="BackupStatus" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- History -->
      <TabItem x:Name="HistoryTab" Header="Historique" Tag="&#xE81C;">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Actualiser" Click="OnRefreshHistory" VerticalAlignment="Center" />
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Pilotes installés" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Ce que Windows Update a installé, par cette application ou par lui-même. Un problème apparu après une date ? Le pilote installé ce jour-là est un bon suspect : « Restaurer le système » ou le Gestionnaire de périphériques permettent de revenir en arrière." />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="HistoryGrid" AutomationProperties.Name="Historique des pilotes"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
                  <DataGridTextColumn Header="Pilote" Binding="{Binding Title}" Width="*" />
                  <DataGridTextColumn Header="Résultat" Binding="{Binding Result}" Width="160" />
                  <DataGridTextColumn Header="Par" Binding="{Binding Via}" Width="120" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="HistoryPlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Text="Chargement…" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="JEUX" Style="{StaticResource NavSection}" />

      <!-- Games: graphics driver, game runtimes, Windows' own gaming settings -->
      <TabItem x:Name="GamesTab" Header="Jeux" Tag="&#xE7FC;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="JEUX" Style="{StaticResource Kicker}" />
            <TextBlock Text="Prêt à jouer" Style="{StaticResource Heading}" FontSize="26" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Le pilote graphique, les composants que les jeux réclament, et les réglages de jeu de Windows." />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="GpuCheckButton" Content="Chercher le dernier pilote" Click="OnGpuCheck" Margin="0,0,8,0" />
                    <Button x:Name="GpuInstallButton" Content="Installer" Style="{DynamicResource AccentButtonStyle}"
                            Click="OnGpuInstall" IsEnabled="False" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Pilote graphique" Style="{StaticResource Heading}" FontSize="17" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Les pilotes « Game Ready » de NVIDIA et AMD sont publiés signés par Microsoft dans le catalogue Microsoft Update, souvent quelques jours après leur sortie. Le jour même, c'est l'application du fabricant." />
                  </StackPanel>
                </DockPanel>
                <ItemsControl x:Name="GpuDriverList" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource PanelRaised}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                  Content="{Binding Tool}" ContentStringFormat="Ouvrir {0}" Tag="{Binding Url}" Click="OnOpenLink"
                                  Visibility="{Binding HasTool, Converter={StaticResource VisibleIf}}" />
                          <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="26"
                                     Foreground="{StaticResource NeonViolet}" VerticalAlignment="Center" Margin="0,0,16,0" />
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Muted}">
                              <Run Text="Installé :" /> <Run Text="{Binding Installed, Mode=OneWay}" Foreground="{StaticResource Ink}" />
                              <Run Text="   Dernier publié :" /> <Run Text="{Binding Latest, Mode=OneWay}" Foreground="{StaticResource NeonCyan}" />
                            </TextBlock>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="ComponentsCheckButton" Content="Vérifier" Click="OnComponentsCheck" Margin="0,0,8,0" />
                    <Button x:Name="ComponentsInstallButton" Content="Installer la sélection" Style="{DynamicResource AccentButtonStyle}"
                            Click="OnComponentsInstall" IsEnabled="False" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Composants de jeu" Style="{StaticResource Heading}" FontSize="17" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Visual C++, DirectX 9, XNA, OpenAL, PhysX : un jeu qui ne se lance pas (« MSVCP140.dll introuvable », « d3dx9_43.dll manquant »…) manque souvent de l'un d'eux. Installés via winget, depuis les sources officielles." />
                  </StackPanel>
                </DockPanel>
                <DataGrid x:Name="ComponentGrid" AutomationProperties.Name="Composants de jeu" Margin="0,10,0,0" Visibility="Collapsed"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInstall}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Component.Name}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Composant" Binding="{Binding Component.Name}" Width="230" />
                    <DataGridTextColumn Header="Utile pour" Binding="{Binding Component.Why}" Width="*" />
                    <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="140" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Conseils par jeu" Style="{StaticResource Heading}" FontSize="17" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Les réglages que les communautés recommandent, pour les jeux Steam installés sur ce PC. Le cfg ajouté se retire d'un clic, vos propres lignes restent." />
                <TextBlock x:Name="GameTipsStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                <ItemsControl x:Name="GameTipList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource PanelRaised}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                        <StackPanel>
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                              <Button Content="{Binding CfgAction}" Tag="{Binding}" Click="OnGameCfg" Margin="0,0,8,0"
                                      Visibility="{Binding Game.HasCfg, Converter={StaticResource VisibleIf}}" />
                              <Button Content="{Binding Game.Tip.LinkText}" ContentStringFormat="Ouvrir {0}" Tag="{Binding Game.Tip.Link}" Click="OnOpenLink"
                                      Visibility="{Binding Game.HasLink, Converter={StaticResource VisibleIf}}" />
                            </StackPanel>
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource NeonViolet}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Game.Tip.Game}" FontFamily="{StaticResource Display}" FontSize="16" VerticalAlignment="Center" />
                          </DockPanel>
                          <ItemsControl ItemsSource="{Binding Game.Tip.Tips}" Margin="32,6,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Muted}" Margin="0,2" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Réglages de jeu de Windows" Style="{StaticResource Heading}" FontSize="17" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Le « Game Boost » des boosters arrête des programmes pour libérer de la mémoire : le Mode jeu de Windows le fait déjà, proprement, à chaque partie. La planification GPU à accélération matérielle réduit la latence sur les cartes récentes. Pour voir ce qui consomme vraiment : onglet Performances." />
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Mode jeu" Tag="ms-settings:gaming-gamemode" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Graphiques et planification GPU" Tag="ms-settings:display-advancedgraphics" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Xbox Game Bar" Tag="ms-settings:gaming-gamebar" Click="OnOpenSetting" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- "PC de guerre": every setting worth changing for games, applied and undone exactly -->
      <TabItem x:Name="TuningTab" Header="PC de guerre" Tag="&#xE945;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="160" Height="160" Margin="0,0,28,0">
                <local:Gauge x:Name="TuningGauge" Thickness="11" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="TuningScore" Text="—" FontFamily="{StaticResource Display}" FontSize="34" HorizontalAlignment="Center" />
                  <TextBlock Text="OPTIMISÉS" Style="{StaticResource Kicker}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="PC DE GUERRE" Style="{StaticResource Kicker}" />
                <TextBlock Text="Tout ce qui se règle pour mieux jouer" Style="{StaticResource Heading}" FontSize="26" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Chaque réglage a un effet réel et s'annule exactement : la valeur d'origine est gardée. Les « boosts » sans effet mesurable (réglages réseau TCP, HPET, services coupés à l'aveugle) n'y sont pas." />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                  <Button x:Name="TuneAllButton" Content="Tout optimiser" Style="{DynamicResource AccentButtonStyle}" Click="OnTuneAll" Margin="0,0,8,0" />
                  <Button x:Name="TuningRefreshButton" Content="Actualiser" Click="OnTuningRefresh" />
                </StackPanel>
                <TextBlock Style="{StaticResource AdminNote}"
                           Text="« Tout optimiser » laisse de côté ce qui demande un choix (sensation de la souris, portable sur batterie) ; une seule autorisation administrateur pour les réglages qui en ont besoin." />
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="À vérifier sur votre matériel" Style="{StaticResource Heading}" FontSize="17" />
                <TextBlock Style="{StaticResource Muted}" Text="Ce qu'aucun réglage ne corrige d'ici, mais qui coûte le plus en jeu." />
                <ItemsControl x:Name="CheckList" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource PanelRaised}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Tag="{Binding Action}" Click="OnCheckAction"
                                  VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasAction, Converter={StaticResource VisibleIf}}" />
                          <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="18"
                                     Foreground="{Binding Color}" VerticalAlignment="Center" Margin="0,0,14,0" />
                          <StackPanel>
                            <TextBlock TextWrapping="Wrap">
                              <Run Text="{Binding Check.Title, Mode=OneWay}" FontWeight="SemiBold" />
                              <Run Text=" — " />
                              <Run Text="{Binding Check.Finding, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Check.Advice}" Style="{StaticResource Muted}" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Jeu" Style="{StaticResource Heading}" FontSize="17" />
                <ItemsControl x:Name="TweakListGame" ItemTemplate="{StaticResource TweakRowTemplate}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Windows plus discret" Style="{StaticResource Heading}" FontSize="17" />
                <TextBlock Style="{StaticResource Muted}" Text="Les réglages de confidentialité les plus suivis (ceux de WinUtil de Chris Titus, entre autres), sans ceux qui cassent quelque chose." />
                <ItemsControl x:Name="TweakListPrivacy" ItemTemplate="{StaticResource TweakRowTemplate}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Espace disque" Style="{StaticResource Heading}" FontSize="17" />
                <ItemsControl x:Name="TweakListSpace" ItemTemplate="{StaticResource TweakRowTemplate}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="SYSTÈME" Style="{StaticResource NavSection}" />

      <!-- Performance -->
      <TabItem x:Name="PerformanceTab" Header="Performances" Tag="&#xEC4A;">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Gestionnaire des tâches" Tag="taskmgr.exe" Click="OnOpenSetting" Margin="0,0,8,0" />
              <Button x:Name="MeasureButton" Content="Analyser (10 s)" Style="{DynamicResource AccentButtonStyle}" Click="OnMeasure" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Ce qui ralentit le PC" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Observe le PC pendant 10 secondes et classe les applications par ce qu'elles consomment. Lancez-la quand le PC rame. Pour agir : onglet Démarrage (ce qui se lance tout seul) ou Logiciels (désinstaller)." />
            </StackPanel>
          </DockPanel>

          <WrapPanel Grid.Row="1" x:Name="UsagePanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="14">
              <Grid Width="150" Height="150">
                <local:Gauge x:Name="CpuGauge" Thickness="10" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="CpuValue" Text="—" FontFamily="{StaticResource Display}" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="PROCESSEUR" Style="{StaticResource Kicker}" HorizontalAlignment="Center" />
                  <TextBlock x:Name="CpuDetail" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="14">
              <Grid Width="150" Height="150">
                <local:Gauge x:Name="MemoryGauge" Thickness="10" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="MemoryValue" Text="—" FontFamily="{StaticResource Display}" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="MÉMOIRE" Style="{StaticResource Kicker}" HorizontalAlignment="Center" />
                  <TextBlock x:Name="MemoryDetail" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="14">
              <Grid Width="150" Height="150">
                <local:Gauge x:Name="DiskGauge" Thickness="10" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="DiskValue" Text="—" FontFamily="{StaticResource Display}" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="DISQUE" Style="{StaticResource Kicker}" HorizontalAlignment="Center" />
                  <TextBlock x:Name="DiskDetail" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="14">
              <Grid Width="150" Height="150">
                <local:Gauge x:Name="GpuGauge" Thickness="10" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="GpuValue" Text="—" FontFamily="{StaticResource Display}" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="CARTE GRAPHIQUE" Style="{StaticResource Kicker}" HorizontalAlignment="Center" />
                  <TextBlock x:Name="GpuDetail" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,14" Width="200">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{StaticResource NeonCyan}" />
                <TextBlock Text="ALIMENTATION" Style="{StaticResource Kicker}" Margin="0,10,0,2" />
                <TextBlock x:Name="PowerValue" Style="{StaticResource Heading}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </WrapPanel>

          <ItemsControl Grid.Row="2" x:Name="FindingList" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="UsageGrid" AutomationProperties.Name="Consommation par application"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Processeur" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="100" />
                  <DataGridTextColumn Header="Mémoire" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="100" />
                  <DataGridTextColumn Header="Disque" Binding="{Binding DiskText}" SortMemberPath="DiskBytesPerSecond" Width="100" />
                  <DataGridTextColumn Header="Carte graphique" Binding="{Binding GpuText}" SortMemberPath="Gpu" Width="120" />
                  <DataGridTextColumn Header="Processus" Binding="{Binding Processes}" Width="80" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="UsagePlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="Lancez une analyse pour voir ce qui consomme." />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- Startup programs and boot measurements -->
      <TabItem x:Name="StartupTab" Header="Démarrage" Tag="&#xE7E8;">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="RefreshStartupButton" Content="Actualiser" Click="OnRefreshStartup" Margin="0,0,8,0" />
              <Button x:Name="BootReportButton" Content="Mesurer leur impact" Style="{DynamicResource AccentButtonStyle}" Click="OnBootReport" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Programmes au démarrage" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Décochez ce qui n'a pas besoin de démarrer avec Windows : c'est réversible, et le Gestionnaire des tâches voit le même réglage. « Mesurer leur impact » lit les temps que Windows a lui-même mesurés lors des derniers démarrages." />
              <TextBlock Style="{StaticResource AdminNote}" Text="Les entrées « Tous les utilisateurs », et parfois la mesure, demandent l'autorisation administrateur." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="StartupGrid" AutomationProperties.Name="Programmes au démarrage"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Actif" Width="56">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnStartupToggle"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Programme" Binding="{Binding Title}" Width="200" />
                <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="170" />
                <DataGridTextColumn Header="Ralentit le démarrage" Binding="{Binding Impact}" Width="150" />
                <DataGridTextColumn Header="Pour" Binding="{Binding Scope}" Width="140" />
                <DataGridTextColumn Header="Commande" Binding="{Binding Command}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" x:Name="BootCard" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Démarrages de Windows (30 derniers jours)" Style="{StaticResource Heading}" FontSize="14" />
              <TextBlock x:Name="BootSummary" TextWrapping="Wrap" />
              <Grid x:Name="BootChart" Margin="0,12,0,4" Visibility="Collapsed"
                    AutomationProperties.Name="Durée des derniers démarrages, en secondes">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="130" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Recessive scale: the top of the scale, its half and the baseline. Bars are 110 px at the top. -->
                <Border Grid.ColumnSpan="2" Height="110" VerticalAlignment="Bottom" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" />
                <Border Grid.ColumnSpan="2" Height="55" VerticalAlignment="Bottom" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,1" />
                <TextBlock x:Name="BootScaleTop" Foreground="{StaticResource InkMuted}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,103" />
                <TextBlock x:Name="BootScaleMid" Foreground="{StaticResource InkMuted}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,48" />
                <ItemsControl x:Name="BootBars" Grid.Column="1">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- The whole column answers the mouse, not only the bar. -->
                      <Grid Height="130" Margin="1,0" Background="Transparent" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                        <StackPanel VerticalAlignment="Bottom">
                          <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,3" />
                          <Border Width="16" Height="{Binding Height}" CornerRadius="4,4,0,0" Background="{StaticResource ChartCyan}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                  <TextBlock x:Name="BootLastDate" DockPanel.Dock="Right" Foreground="{StaticResource InkMuted}" FontSize="11" />
                  <TextBlock x:Name="BootFirstDate" Foreground="{StaticResource InkMuted}" FontSize="11" />
                </DockPanel>
              </Grid>
              <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <ItemsControl x:Name="SlowdownList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,2" TextWrapping="Wrap">
                        <Run Text="{Binding FriendlyName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" — " />
                        <Run Text="{Binding Kind, Mode=OneWay}" />
                        <Run Text=" — " />
                        <Run Text="{Binding AverageText, Mode=OneWay}" />
                        <Run Text="en moyenne," Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding Times, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="fois" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Health -->
      <TabItem x:Name="HealthTab" Header="Santé et nettoyage" Tag="&#xE95E;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,0,0">

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Sécurité Windows" Tag="windowsdefender:" Click="OnOpenSetting" Margin="0,0,8,0" />
                    <Button Content="Windows Update" Tag="ms-settings:windowsupdate" Click="OnOpenSetting" />
                  </StackPanel>
                  <TextBlock Text="Sécurité" Style="{StaticResource Heading}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}"
                           Text="Ce que Windows Security surveille déjà : antivirus actif et à jour, pare-feu actif, mises à jour de Windows en attente. Pas de « score » : des faits, et où agir." />
                <TextBlock x:Name="SecuritySummary" Margin="0,8,0,0" TextWrapping="Wrap" Text="Chargement…" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="RestorePointsButton" Content="Afficher" Click="OnRestorePoints" Margin="0,0,8,0" />
                    <Button x:Name="CreateRestorePointButton" Content="Créer maintenant" Click="OnCreateRestorePoint" Margin="0,0,8,0" />
                    <Button Content="Restaurer le système" Tag="rstrui.exe" Click="OnOpenSetting" />
                  </StackPanel>
                  <TextBlock Text="Points de restauration" Style="{StaticResource Heading}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}"
                           Text="L'application en crée un avant chaque installation de pilote. Créez-en un vous-même avant de tester un réglage risqué ; « Restaurer le système » remet Windows à la date choisie, sans toucher à vos documents." />
                <TextBlock Style="{StaticResource AdminNote}" Text="Windows demandera l'autorisation administrateur pour lire la liste et créer un point." />
                <ItemsControl x:Name="RestorePointList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,2">
                        <Run Text="{Binding Created, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}" FontWeight="SemiBold" />
                        <Run Text=" — " />
                        <Run Text="{Binding Description, Mode=OneWay}" Foreground="{StaticResource InkMuted}" />
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="HealthDetailsButton" DockPanel.Dock="Right" Content="Usure et température…"
                          Click="OnHealthDetails" VerticalAlignment="Top" />
                  <TextBlock Text="Disques" Style="{StaticResource Heading}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}"
                           Text="État rapporté par Windows. « Avertissement » ou « Défaillant », ou une usure proche de 100 % : sauvegardez vos données sans attendre. L'usure, la température et la batterie demandent l'autorisation administrateur." />
                <DataGrid x:Name="DiskGrid" Margin="0,8,0,0" AutomationProperties.Name="Disques"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Disque" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                    <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="90" />
                    <DataGridTextColumn Header="État" Binding="{Binding Health}" Width="110" />
                    <DataGridTextColumn Header="Usure" Binding="{Binding Wear}" Width="70" />
                    <DataGridTextColumn Header="Température" Binding="{Binding Temperature}" Width="100" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="DiskStatus" Style="{StaticResource Muted}" />
              </StackPanel>
            </Border>

            <Border x:Name="BatteryCard" Style="{StaticResource Card}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Batterie" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Capacité restante comparée à une batterie neuve. Sous 80 %, l'autonomie baisse nettement ; sous 60 %, pensez à la remplacer." />
                <DataGrid x:Name="BatteryGrid" Margin="0,8,0,0" AutomationProperties.Name="Batteries"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Batterie" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Neuve" Binding="{Binding Designed}" Width="90" />
                    <DataGridTextColumn Header="Aujourd'hui" Binding="{Binding FullCharge}" Width="100" />
                    <DataGridTextColumn Header="Santé" Binding="{Binding Health}" Width="80" />
                    <DataGridTextColumn Header="Cycles" Binding="{Binding Cycles}" Width="70" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Fichiers temporaires" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Fichiers de plus de 2 jours dans votre dossier temporaire. Les fichiers en cours d'utilisation sont laissés en place. Le dossier temporaire de Windows (C:\Windows\Temp) demande l'autorisation administrateur." />
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="ScanTempButton" Content="Analyser" Click="OnScanTemp" Margin="0,0,8,8" />
                  <Button x:Name="CleanTempButton" Content="Supprimer" Style="{DynamicResource AccentButtonStyle}"
                          Click="OnCleanTemp" IsEnabled="False" Margin="0,0,8,8" />
                  <Button x:Name="CleanWindowsTempButton" Content="Nettoyer aussi C:\Windows\Temp…"
                          Click="OnCleanWindowsTemp" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock x:Name="TempStatus" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Réparer Windows" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Les outils de Microsoft. SFC vérifie et répare les fichiers système ; DISM répare l'image de Windows dont SFC se sert (à lancer d'abord si SFC n'y arrive pas) ; le nettoyage des composants supprime les anciennes versions gardées après les mises à jour et libère souvent plusieurs Go. Comptez 10 à 30 minutes." />
                <TextBlock Style="{StaticResource AdminNote}" />
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="SfcButton" Content="Vérifier les fichiers système (SFC)" Tag="sfc" Click="OnRepair" Margin="0,0,8,8" />
                  <Button x:Name="DismRestoreButton" Content="Réparer l'image Windows (DISM)" Tag="dism-restore" Click="OnRepair" Margin="0,0,8,8" />
                  <Button x:Name="DismCleanupButton" Content="Nettoyer les composants Windows" Tag="dism-cleanup" Click="OnRepair" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock x:Name="RepairStatus" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Réglages Windows utiles" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="Les outils intégrés font mieux qu'un « booster » : ils montrent l'impact réel de chaque élément." />
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Applications au démarrage" Tag="ms-settings:startupapps" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Assistant de stockage" Tag="ms-settings:storagesense" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Alimentation" Tag="ms-settings:powersleep" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Historique des mises à jour" Tag="ms-settings:windowsupdate-history" Click="OnOpenSetting" Margin="0,0,8,8" />
                  <Button Content="Restaurer le système" Tag="rstrui.exe" Click="OnOpenSetting" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="LOGICIELS" Style="{StaticResource NavSection}" />

      <!-- Software: updates and installed programs -->
      <TabItem x:Name="SoftwareTab" Header="Logiciels" Tag="&#xE71D;">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SearchSoftwareButton" Content="Rechercher" Click="OnSearchSoftware" Margin="0,0,8,0" />
              <Button x:Name="UpgradeSoftwareButton" Content="Mettre à jour la sélection" Style="{DynamicResource AccentButtonStyle}"
                      Click="OnUpgradeSoftware" IsEnabled="False" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Mises à jour de logiciels" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Via winget, le gestionnaire de logiciels intégré à Windows. Un logiciel à jour, c'est des failles de sécurité en moins. Windows peut demander une autorisation pour certains d'entre eux." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <DataGrid x:Name="SoftwareGrid" AutomationProperties.Name="Logiciels à mettre à jour"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Name}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Logiciel" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Installé" Binding="{Binding Version}" Width="130" />
                  <DataGridTextColumn Header="Disponible" Binding="{Binding Available}" Width="130" />
                  <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="SoftwarePlaceholder" Style="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="Lancez une recherche pour voir les logiciels à mettre à jour." />
            </Grid>
          </Border>

          <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
              <TextBox x:Name="ProgramFilter" Width="200" Margin="0,0,8,0" VerticalContentAlignment="Center"
                       TextChanged="OnProgramFilterChanged" AutomationProperties.Name="Filtrer les programmes" />
              <Button x:Name="UninstallButton" Content="Désinstaller…" Click="OnUninstall" Margin="0,0,8,0" />
              <Button x:Name="FindLeftoversButton" Content="Chercher les restes" Click="OnFindLeftovers" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Programmes installés" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Désinstaller lance le désinstalleur du programme. Ensuite, « Chercher les restes » propose les dossiers qu'il a laissés ; ils partent à la corbeille, donc rien n'est perdu. Le registre n'est pas « nettoyé » : ça ne fait rien gagner et c'est la cause de casse n° 1." />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="ProgramGrid" AutomationProperties.Name="Programmes installés" SelectionMode="Single"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Programme" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="180" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
                <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" SortMemberPath="Size" Width="80" />
                <DataGridTextColumn Header="Installé le" Binding="{Binding InstalledOn, StringFormat=dd/MM/yyyy}" Width="90" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <Border x:Name="LeftoverCard" Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
              <DockPanel>
                <Button x:Name="RecycleButton" DockPanel.Dock="Right" Content="Mettre à la corbeille" Style="{DynamicResource AccentButtonStyle}"
                        Click="OnRecycleLeftovers" VerticalAlignment="Top" />
                <TextBlock x:Name="LeftoverHeading" Style="{StaticResource Heading}" FontSize="14" TextWrapping="Wrap" />
              </DockPanel>
              <TextBlock Style="{StaticResource Muted}"
                         Text="Cochés d'office : le dossier d'installation déclaré. Les autres portent seulement le même nom : vérifiez avant de cocher. Dossiers de Program Files et ProgramData : autorisation administrateur." />
              <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl x:Name="LeftoverList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Margin="0,2">
                        <TextBlock TextWrapping="Wrap">
                          <Run Text="{Binding Path, Mode=OneWay}" />
                          <Run Text=" — " />
                          <Run Text="{Binding Reason, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1">
      <Border x:Name="DeviceBanner" Background="#1A00E5FF" BorderBrush="{StaticResource NeonCyan}" BorderThickness="0,1,0,0"
              Padding="20,10" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="DeviceBannerButton" DockPanel.Dock="Right" Content="Chercher un pilote" Style="{DynamicResource AccentButtonStyle}"
                  Click="OnDeviceBanner" />
          <TextBlock DockPanel.Dock="Left" Text="&#xE772;" FontFamily="{StaticResource Icons}" FontSize="18"
                     Foreground="{StaticResource NeonCyan}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock x:Name="DeviceBannerText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
      <Border x:Name="UpdateBanner" Background="#1AB44DFF" BorderBrush="{StaticResource NeonViolet}" BorderThickness="0,1,0,0"
              Padding="20,10" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="UpdateBannerButton" DockPanel.Dock="Right" Content="Voir les nouveautés" Click="OnOpenLink" />
          <Button x:Name="UpdateInstallButton" DockPanel.Dock="Right" Content="Installer la mise à jour" Style="{DynamicResource AccentButtonStyle}"
                  Click="OnInstallAppUpdate" Margin="0,0,8,0" Visibility="Collapsed" />
          <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
      <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="20,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Copier le diagnostic" Click="OnCopyDiagnostics" Margin="12,0,0,0" />
          <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="180" Height="4" VerticalAlignment="Center"
                       IsIndeterminate="True" Visibility="Collapsed" />
          <TextBlock x:Name="StatusText" Text="Prêt." VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource InkMuted}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>
