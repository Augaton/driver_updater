<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The app targets Windows only; linking its portable logic lets the tests run anywhere. -->
  <ItemGroup>
    <Compile Include="..\..\src\DriverUpdater\TempCleaner.cs" Link="TempCleaner.cs" />
    <Compile Include="..\..\src\DriverUpdater\AdminCommand.cs" Link="AdminCommand.cs" />
    <Compile Include="..\..\src\DriverUpdater\WingetOutput.cs" Link="WingetOutput.cs" />
    <Compile Include="..\..\src\DriverUpdater\UpdateCheck.cs" Link="UpdateCheck.cs" />
    <Compile Include="..\..\src\DriverUpdater\Bytes.cs" Link="Bytes.cs" />
    <Compile Include="..\..\src\DriverUpdater\Catalog.cs" Link="Catalog.cs" />
    <Compile Include="..\..\src\DriverUpdater\CommandLine.cs" Link="CommandLine.cs" />
    <Compile Include="..\..\src\DriverUpdater\StartupApproval.cs" Link="StartupApproval.cs" />
    <Compile Include="..\..\src\DriverUpdater\Leftovers.cs" Link="Leftovers.cs" />
    <Compile Include="..\..\src\DriverUpdater\PerfModel.cs" Link="PerfModel.cs" />
    <Compile Include="..\..\src\DriverUpdater\BootEvents.cs" Link="BootEvents.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
